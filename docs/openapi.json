  "components": {
    "schemas": {
      "CompleteIntakeRequest": {
        "properties": {
          "document_version_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Document Version Id"
          },
          "content_checksum": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Content Checksum"
          }
        },
        "type": "object",
        "required": [
          "document_version_id",
          "content_checksum"
        ],
        "title": "CompleteIntakeRequest"
      },
      "CreateIndexProfileRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "embedding_profile_id": {
            "type": "string",
            "minLength": 1,
            "title": "Embedding Profile Id"
          },
          "sparse_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sparse Profile Id"
          },
          "reranker_profile_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reranker Profile Id"
          },
          "collection": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Collection"
          },
          "dimensions": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Dimensions"
          },
          "distance_metric": {
            "type": "string",
            "pattern": "^(cosine|dot|euclid)$",
            "title": "Distance Metric",
            "default": "cosine"
          },
          "chunking_strategy": {
            "type": "string",
            "pattern": "^(RECURSIVE|SENTENCE|FIXED|PARAGRAPH)$",
            "title": "Chunking Strategy",
            "default": "RECURSIVE"
          },
          "chunk_size_tokens": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 50.0,
            "title": "Chunk Size Tokens",
            "default": 400
          },
          "chunk_overlap_tokens": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Chunk Overlap Tokens",
            "default": 50
          },
          "parent_chunk_size": {
            "type": "integer",
            "maximum": 5000.0,
            "minimum": 100.0,
            "title": "Parent Chunk Size",
            "default": 1500
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "embedding_profile_id",
          "collection",
          "dimensions"
        ],
        "title": "CreateIndexProfileRequest"
      },
      "CreateIntakeRequest": {
        "properties": {
          "knowledge_base_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Knowledge Base Id"
          },
          "filename": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Filename"
          },
          "mime_type": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Mime Type"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Size Bytes"
          },
          "source_revision": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Revision"
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 512
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "knowledge_base_id",
          "filename",
          "mime_type",
          "size_bytes"
        ],
        "title": "CreateIntakeRequest"
      },
      "CreateKnowledgeBaseRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Slug"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "slug"
        ],
        "title": "CreateKnowledgeBaseRequest"
      },
      "CreateModelProfileRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name"
          },
          "profile_kind": {
            "type": "string",
            "pattern": "^(DENSE_EMBEDDING|SPARSE_EMBEDDING|RERANKER|GENERATION)$",
            "title": "Profile Kind"
          },
          "provider": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Model"
          },
          "modality": {
            "type": "string",
            "pattern": "^(TEXT|IMAGE|MULTIMODAL)$",
            "title": "Modality",
            "default": "TEXT"
          },
          "dimensions": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Dimensions"
          },
          "config_json": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config Json"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "profile_kind",
          "provider",
          "model"
        ],
        "title": "CreateModelProfileRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RagAnswerFeedbackRequest": {
        "properties": {
          "rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating",
            "description": "Optional 1-5 rating for the retained answer"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment",
            "description": "Optional bounded feedback comment"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RagAnswerFeedbackRequest"
      },
      "RagQueryRequest": {
        "properties": {
          "conversation_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Id",
            "description": "Optional server-owned conversation identifier"
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message",
            "description": "Question to answer from permitted evidence"
          },
          "knowledge_base_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "minItems": 1,
            "title": "Knowledge Base Ids",
            "description": "Knowledge bases the caller may select"
          },
          "mode": {
            "type": "string",
            "pattern": "^(grounded)$",
            "title": "Mode",
            "description": "Only grounded mode is supported",
            "default": "grounded"
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "Request an SSE response when enabled",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message",
          "knowledge_base_ids"
        ],
        "title": "RagQueryRequest",
        "examples": [
          {
            "knowledge_base_ids": [
              "knowledge-base-id"
            ],
            "message": "What is the retention policy?",
            "stream": false
          }
        ]
      },
      "RegisterRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
