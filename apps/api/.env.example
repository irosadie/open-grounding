API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vibecoding_starter
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
DEPLOYMENT_TENANT_ID=replace-with-a-valid-uuid
TENANT_MODE=single-deployment

# --- RAG platform (disabled by default) ---
RAG_ENABLED=false
RAG_RUNTIME_MODE=development
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_STRICT_MODE=true
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_BUCKET=rag-artifacts
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_LOCAL_PATH=

RAG_QUERY_ENABLED=false
RAG_QUERY_PROFILE_ID=default-v1
RAG_QUERY_MAX_MESSAGE_CHARS=8000
RAG_QUERY_MAX_PAYLOAD_BYTES=16384
RAG_QUERY_RECENT_MESSAGES=6
RAG_QUERY_REQUESTS_PER_MINUTE=60
RAG_QUERY_MAX_CONCURRENCY=8
RAG_QUERY_TIMEOUT_SECONDS=30
RAG_RETRIEVAL_TIMEOUT_SECONDS=8
RAG_GENERATION_TIMEOUT_SECONDS=20
RAG_RETRIEVAL_DENSE_CANDIDATES=50
RAG_RETRIEVAL_SPARSE_CANDIDATES=50
RAG_RETRIEVAL_FUSED_CANDIDATES=40
RAG_RETRIEVAL_RERANKER_CANDIDATES=24
RAG_CONTEXT_MAX_CHUNKS=12
RAG_CONTEXT_TOKEN_BUDGET=8000
RAG_GENERATION_MAX_OUTPUT_TOKENS=1024
RAG_QUERY_TRACE_RETENTION_DAYS=30
RAG_QUERY_MAX_RETRIEVAL_RETRIES=1
RAG_QUERY_MAX_VALIDATION_REPAIRS=1
