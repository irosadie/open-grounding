API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vibecoding_starter
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
DEPLOYMENT_TENANT_ID=replace-with-a-valid-uuid
TENANT_MODE=single-deployment

# --- RAG platform (disabled by default) ---
RAG_ENABLED=false
RAG_RUNTIME_MODE=development
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_STRICT_MODE=true
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
OBJECT_STORE_BUCKET=rag-artifacts
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_LOCAL_PATH=
