API_PORT=3011
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/open_grounding
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
DEPLOYMENT_TENANT_ID=replace-with-a-valid-uuid
TENANT_MODE=single-deployment

# Secret key for encrypting provider credentials at rest (CRITICAL — do not lose)
SECRET_KEY=replace-with-a-long-random-secret-key

# --- RAG platform ---
RAG_ENABLED=true
RAG_RUNTIME_MODE=development
QDRANT_URL=http://127.0.0.1:6334
QDRANT_API_KEY=qdrant-dev-key
OBJECT_STORE_ENDPOINT=http://127.0.0.1:9100
OBJECT_STORE_ACCESS_KEY=minioadmin
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=rag-artifacts
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_LOCAL_PATH=

# Redis (worker)
REDIS_URL=redis://127.0.0.1:6379

# Embedding providers (set via UI or here as fallback)
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
FASTEMBED_CACHE_DIR=
