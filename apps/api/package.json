{
  "name": "@vibecoding-starter/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "uv run uvicorn app.main:app --host 0.0.0.0 --port ${API_PORT:-3001} --reload",
    "build": "uv run python -m compileall -q app",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port ${API_PORT:-3001}",
    "lint": "uv run ruff check app tests",
    "format": "uv run ruff format app tests",
    "typecheck": "uv run mypy app",
    "test": "uv run pytest",
    "test:integration": "RUN_DATABASE_TESTS=1 DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/vibecoding_starter_test uv run pytest tests/test_repository_integration.py",
    "test:smoke": "uv run pytest tests/test_system_routes.py",
    "db:upgrade": "uv run alembic upgrade head",
    "db:stamp-baseline": "uv run alembic stamp 20260729_01",
    "openapi:generate": "uv run python -m app.export_openapi"
  }
}
